# ==========================================
# Sapphire IQ RealEstate - Environment Variables
# ==========================================

# 1. MongoDB Atlas Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/realestate?retryWrites=true&w=majority

# 2. NextAuth v5 Authentication Secret & URL
AUTH_SECRET=your_nextauth_jwt_secret_generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# 3. Google OAuth 2.0 Credentials (Optional)
AUTH_GOOGLE_ID=your_google_client_id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_client_secret

# 4. Nodemailer SMTP Credentials (Gmail or SMTP Provider)
EMAIL=your_email@gmail.com
PASS=your_gmail_app_password

# 5. ImageKit CDN Credentials (for Property Photo Uploads)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# 6. Optional Feature Flags & AI Hub
NEXT_PUBLIC_ENABLE_AI_HUB=true
FIRECRAWL_API_KEY=your_firecrawl_api_key_optional

# 7. Security & CORS
ALLOWED_ORIGIN=http://localhost:3000
